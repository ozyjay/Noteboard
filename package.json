{
  "name": "inquiry",
  "version": "0.1.0",
  "private": true,
  "description": "Noteboard — human-directed spatial inquiry and synthesis",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src electron scripts tests docs skills AGENTS.md README.md *.json *.ts",
    "format:check": "prettier --check src electron scripts tests docs skills AGENTS.md README.md *.json *.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.7.0",
    "esbuild": "^0.28.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module"
}
